# SmartHire Environment Configuration
# Copy this file to .env (and backend/.env if running services separately) and populate your keys.

# ==============================================================================
# Server & Application Gateway
# ==============================================================================
PORT=8000
HOST=0.0.0.0
DEBUG=True
ENVIRONMENT=development

# ==============================================================================
# Database Configuration
# ==============================================================================
# Default: Zero-configuration SQLite for instantaneous out-of-the-box local setup
DATABASE_URL=sqlite:///./smarthire.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smarthire

# ==============================================================================
# Security & JWT Authentication
# ==============================================================================
JWT_SECRET=super_secret_smarthire_jwt_key_change_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==============================================================================
# Live Job Aggregation APIs
# ==============================================================================
# SerpAPI powers live Google Jobs search with direct apply links
# Get your free key at: https://serpapi.com/ (100 free searches/month)
# If left blank, FallbackJobProvider provides 15 realistic tech job openings with direct search apply links
SERPAPI_API_KEY=
LINKEDIN_API_KEY=

# ==============================================================================
# LLM Providers (Mock Interview & Adaptive Question Engine)
# ==============================================================================
# SmartHire automatically detects which key is configured:
# 1. Google Gemini (Recommended for free tier): https://aistudio.google.com/
# 2. OpenAI: https://platform.openai.com/
# If neither is set, SmartHire uses its built-in contextual heuristic evaluation & adaptive questioning engine
GEMINI_API_KEY=
OPENAI_API_KEY=

# ==============================================================================
# Voice & Audio Speech Services
# ==============================================================================
# Optional: OpenAI Whisper for audio transcription and ElevenLabs for custom neural voice
# Out-of-the-box fallback uses browser Web Speech API recognition and Edge-TTS synthesis
ELEVENLABS_API_KEY=

# ==============================================================================
# Hybrid Ranking Hyperparameters
# ==============================================================================
BM25_WEIGHT=0.45
COSINE_WEIGHT=0.55

# ==============================================================================
# CORS Configuration
# ==============================================================================
# Comma-separated list of permitted origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
